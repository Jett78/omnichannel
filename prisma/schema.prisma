// Unified Omnichannel Inbox — Prisma schema (Phases 1–4)
// Multi-tenant: every tenant-owned row carries workspaceId and all
// service-layer queries are scoped by it (see services/).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum Provider {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  TELEGRAM
  X
  TIKTOK
  GMAIL
  /** Website live-chat widget (Phase 11) — our own channel, no external platform. */
  WEBSITE
  /** Dev/test-only provider (Phase 4). Never a real platform. */
  MOCK
}

enum ChannelStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
  ERROR
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SNOOZED
}

enum ConversationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  STICKER
  SYSTEM
  PRIVATE_NOTE
  TEMPLATE
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum SenderType {
  CONTACT
  AGENT
  SYSTEM
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  ASSIGNMENT
  MENTION
  INVITATION
  SYSTEM
}

// ─── Identity & Tenancy ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  assigned      Conversation[]           @relation("ConversationAssignee")
  messages      Message[]                @relation("MessageSenderUser")
  invitations   Invitation[]             @relation("InvitationInviter")
  auditLogs     AuditLog[]
  assignments   ConversationAssignment[] @relation("AssignmentAssignee")
  assignedBy    ConversationAssignment[] @relation("AssignmentAssigner")
  notifications Notification[]
  oauthSessions OAuthConnectionSession[]
}

// Better Auth — session (database sessions, Prisma adapter)
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Better Auth — account (credential password lives in Account.password)
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

// Better Auth — verification (email verification + password reset tokens)
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kathmandu")
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       WorkspaceMember[]
  teams         Team[]
  channels      Channel[]
  contacts      Contact[]
  conversations Conversation[]
  tags          Tag[]
  canned        CannedResponse[]
  outgoingWebhooks OutgoingWebhook[]
  automationRules  AutomationRule[]
  automationRuns   AutomationRun[]
  knowledgeEntries KnowledgeEntry[]
  storeConnection  StoreConnection?
  aiConfig         AiConfig?
  aiUsageLogs      AiUsageLog[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  assignments   ConversationAssignment[]
  notifications Notification[]
  oauthSessions OAuthConnectionSession[]
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  teamId      String?
  role        Role     @default(AGENT)
  /** Phase 13B — smart-assignment availability (agents can toggle). */
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([teamId])
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        Role             @default(AGENT)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
}

// ─── Channels ─────────────────────────────────────────────────────────────────

model Channel {
  id                 String        @id @default(cuid())
  workspaceId        String
  provider           Provider
  externalAccountId  String
  displayName        String
  status             ChannelStatus @default(CONNECTED)
  config             Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential  ChannelCredential?
  identities  ContactIdentity[]
  conversations Conversation[]
  webhookEvents WebhookEvent[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([workspaceId, provider])
}

/**
 * Short-lived OAuth hand-off state for channel connections (Phase 5,
 * Meta). Created when a user starts a provider OAuth flow; the
 * callback looks the row up by `stateHash` (SHA-256 of the OAuth
 * `state` value — the raw state only ever lives in the browser cookie
 * + provider redirect). After the code exchange, the provider payload
 * (long-lived user token + selectable accounts incl. their tokens) is
 * stored AES-256-GCM encrypted in `encryptedData` until the user picks
 * an account, at which point the session is consumed and the payload
 * wiped. Tokens are never returned to the browser — the session API
 * only exposes sanitized account metadata.
 */
model OAuthConnectionSession {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  provider      Provider
  stateHash     String    @unique
  encryptedData String
  scopes        String[]
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
}

model ChannelCredential {
  id                     String    @id @default(cuid())
  channelId              String    @unique
  encryptedAccessToken   String
  encryptedRefreshToken  String?
  tokenExpiresAt         DateTime?
  scopes                 String[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

// ─── Contacts ─────────────────────────────────────────────────────────────────

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  displayName String
  avatarUrl   String?
  phone       String?
  email       String?
  customAttrs Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities    ContactIdentity[]
  conversations Conversation[]

  @@index([workspaceId, email])
  @@index([workspaceId, phone])
}

model ContactIdentity {
  id             String   @id @default(cuid())
  contactId      String
  channelId      String
  externalUserId String
  username       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalUserId])
  @@index([contactId])
}

// ─── Conversations & Messages ─────────────────────────────────────────────────

model Conversation {
  id               String             @id @default(cuid())
  workspaceId      String
  channelId        String
  contactId        String
  status           ConversationStatus @default(OPEN)
  priority         ConversationPriority?
  /** When a SNOOZED conversation should auto-reopen; null = until next reply. */
  snoozedUntil     DateTime?
  assigneeId       String?
  externalThreadId String?
  lastMessageAt    DateTime?
  unreadCount      Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact     Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    Message[]
  tags        ConversationTag[]
  assignments ConversationAssignment[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([channelId, contactId])
  @@index([assigneeId])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  body              String?
  senderType        SenderType
  senderUserId      String?
  externalMessageId String?
  status            MessageStatus    @default(RECEIVED)
  /** Platform-specific metadata (raw ids, delivery errors, provider extras).
   *  Kept separate from the unified message fields — see types/messaging.ts. */
  metadata          Json?
  sentAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?               @relation("MessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([externalMessageId])
}

model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String
  storageKey  String?
  originalUrl String?
  mimeType    String?
  fileName    String?
  size        Int?
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  storedMedia StoredMedia?

  @@index([messageId])
}

/**
 * Our own copy of an outbound attachment's bytes. Some platforms
 * (Meta) hand back an attachment id that can be re-sent but never
 * downloaded again, so without this copy the inbox thread could only
 * show a file chip for images the agent sent. The media route serves
 * these bytes for thread previews; platform downloads remain the
 * fallback for references without a stored copy.
 */
model StoredMedia {
  id           String   @id @default(cuid())
  attachmentId String   @unique
  mimeType     String
  data         Bytes
  createdAt    DateTime @default(now())

  attachment MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

// ─── Tags & Canned Responses ──────────────────────────────────────────────────

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([workspaceId, name])
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
}

model CannedResponse {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  body        String
  shortcut    String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── Webhooks & Audit ─────────────────────────────────────────────────────────

/**
 * Outgoing webhooks (Phase 12): workspace-configured HTTP endpoints
 * that receive product events (conversation.created, message.created,
 * …) as signed JSON POSTs. The secret is an HMAC-SHA256 key the
 * receiver uses to verify deliveries; it is shown to workspace
 * admins in Settings (it is not a credential for OUR system).
 */
model OutgoingWebhook {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  url         String
  secret      String
  events      String[]
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

/** One row per delivery ATTEMPT of an outgoing webhook. */
model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  success    Boolean
  statusCode Int?
  error      String?
  createdAt  DateTime @default(now())

  webhook OutgoingWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model WebhookEvent {
  id              String             @id @default(cuid())
  provider        Provider
  channelId       String?
  externalEventId String?
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  error           String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([provider, externalEventId])
  @@index([status, receivedAt])
}

model ConversationAssignment {
  id                 String   @id @default(cuid())
  workspaceId        String
  conversationId     String
  assigneeId         String?
  assignedById       String?
  previousAssigneeId String?
  note               String?
  createdAt          DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedBy   User?        @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, conversationId, createdAt])
  @@index([assigneeId])
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  type        NotificationType @default(SYSTEM)
  title       String
  body        String?
  entity      String?
  entityId    String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entity      String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// ─── Automation (Phase 13B) ─────────────────────────────────────────

/**
 * A workspace automation rule: when `trigger` fires and `conditions`
 * match, run `actions` in order. conditions/actions are JSON validated
 * by the API schemas (see lib/validations.ts) and typed in
 * services/automation.service.ts. Smart assignment is the `assign`
 * action with a round_robin / least_busy strategy over available
 * members. `roundRobinCursor` = the userId picked last by this rule.
 */
model AutomationRule {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  enabled          Boolean  @default(true)
  trigger          String
  conditions       Json?
  actions          Json
  roundRobinCursor String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AutomationRun[]

  @@index([workspaceId, trigger, enabled])
}

/** One execution of a rule against one conversation (audit trail). */
model AutomationRun {
  id             String   @id @default(cuid())
  workspaceId    String
  ruleId         String
  conversationId String
  trigger        String
  /** Per-action outcomes: [{ type, ok, detail }]. */
  results        Json
  createdAt      DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
}

// ─── AI assistant (Phase 13G) ───────────────────────────────────────

/**
 * Workspace knowledge the AI assistant may use when drafting replies
 * (policies, FAQs, product facts). Admin-managed; plain text.
 */
model AiConfig {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        String
  model           String
  baseUrl         String
  encryptedApiKey String
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model StoreConnection {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  baseUrl     String
  name        String?
  enabled     Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model KnowledgeEntry {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/** One row per AI action (suggest/rewrite/summarize/sentiment/translate) — honest usage counting. */
model AiUsageLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
