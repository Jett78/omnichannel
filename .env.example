# ─── Unified Omnichannel Inbox — environment template ─────────────────────────
# Copy to .env and fill in:  cp .env.example .env
# NEVER commit a filled .env with real secrets.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the web app
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Matches docker-compose.yml defaults (user / password / db = uoi)
DATABASE_URL=postgresql://uoi:uoi_password@localhost:5432/uoi?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Legacy Phase 1 names (kept for compatibility, no longer used by auth)
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# ─── Mail (optional — without SMTP_*, the dev mailer logs links to console) ──
MAIL_FROM=Unified Inbox <no-reply@uoi.local>
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key, hex (64 chars) or base64. Used to encrypt channel credentials
# at rest (AES-256-GCM). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-char-hex-key

# ─── Object storage (S3-compatible, used from Phase 2 for media) ─────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Realtime (Phase 4 — standalone Socket.IO gateway: npm run realtime) ─────
SOCKET_PORT=4001
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# ─── Mock provider (Phase 4 — DEV/TEST ONLY, never a real platform) ──────────
# Enabled automatically when NODE_ENV != production; set to "true" to force
# it on, or leave unset in production to keep it disabled.
# ENABLE_MOCK_PROVIDER=
MOCK_WEBHOOK_SECRET=dev-mock-secret

# ─── Providers (Phase 4–7 — leave empty in Phase 1, no integrations yet) ─────
# Facebook / Instagram (Meta)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
