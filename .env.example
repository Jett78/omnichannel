# ─── Unified Omnichannel Inbox — environment template ─────────────────────────
# Copy to .env and fill in:  cp .env.example .env
# NEVER commit a filled .env with real secrets.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the web app
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Matches docker-compose.yml defaults (user / password / db = uoi)
DATABASE_URL=postgresql://uoi:uoi_password@localhost:5432/uoi?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Legacy Phase 1 names (kept for compatibility, no longer used by auth)
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# ─── Mail (optional — without SMTP_*, the dev mailer logs links to console) ──
MAIL_FROM=Unified Inbox <no-reply@uoi.local>
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key, hex (64 chars) or base64. Used to encrypt channel credentials
# at rest (AES-256-GCM). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-char-hex-key

# ─── Object storage (S3-compatible, used from Phase 2 for media) ─────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Realtime (Phase 4 — standalone Socket.IO gateway: npm run realtime) ─────
SOCKET_PORT=4001
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# ─── Mock provider (Phase 4 — DEV/TEST ONLY, never a real platform) ──────────
# Enabled automatically when NODE_ENV != production; set to "true" to force
# it on, or leave unset in production to keep it disabled.
# ENABLE_MOCK_PROVIDER=
MOCK_WEBHOOK_SECRET=dev-mock-secret

# ─── Providers ────────────────────────────────────────────────────────────────
# Facebook Messenger (Phase 5 — Meta app with the Messenger product;
# setup + App Review steps: docs/META-APP-REVIEW.md)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version (default v25.0)
META_GRAPH_API_VERSION=v25.0
# Optional: override the OAuth redirect URI (default ${APP_URL}/api/oauth/facebook/callback)
# META_FACEBOOK_REDIRECT_URI=
# Optional: set to "true" to send appsecret_proof with Graph API calls
# META_APPSECRET_PROOF=
# Instagram (Phase 5 — Instagram API with Instagram Login; these are the
# Instagram product's OWN app id/secret from the Meta dashboard, distinct
# from the Facebook app secret above)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: override the OAuth redirect URI (default ${APP_URL}/api/oauth/instagram/callback)
# INSTAGRAM_REDIRECT_URI=
# Optional: webhook verify token for Instagram (falls back to META_WEBHOOK_VERIFY_TOKEN)
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Business Platform Cloud API (Phase 6 — setup: docs/WHATSAPP-SETUP.md)
# Webhook signature secret (falls back to META_APP_SECRET when unset)
WHATSAPP_APP_SECRET=
# Webhook verify token for the GET handshake (falls back to META_WEBHOOK_VERIFY_TOKEN)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business configuration id — required for Embedded Signup
# (manual system-user-token connect works without it)
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional: WhatsApp Graph API version (falls back to META_GRAPH_API_VERSION, default v25.0)
# WHATSAPP_GRAPH_API_VERSION=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
# TikTok — Business Messaging API (TikTok API for Business developer app ID/secret).
# ACCESS-GATED: credentials alone do NOT enable messaging. TikTok must first approve
# the developer via its Data Security & Privacy Review (plus the US Data Security
# Review + USDS Addendum for US-registered accounts). See docs/TIKTOK-ACCESS.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: OAuth redirect URI override (defaults to {APP_URL}/api/oauth/tiktok/callback)
# TIKTOK_REDIRECT_URI=
# Optional: webhook secret for the future approved integration
# TIKTOK_WEBHOOK_SECRET=
